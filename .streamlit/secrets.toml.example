# Copy this file to .streamlit/secrets.toml to configure OAuth 2.0 + OpenID Connect (OIDC).
# Option A: Local OIDC Identity Provider (run src/oidc_provider.py on port 8502)
# Option B: Google Cloud OAuth 2.0 (set server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration")

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-32-plus-char-secret-key"
expose_tokens = ["id", "access"]

[auth.google]
client_id = "raksha-oidc-client"
client_secret = "raksha-oidc-secret-2026"
server_metadata_url = "http://localhost:8502/.well-known/openid-configuration"
